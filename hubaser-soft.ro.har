            "mimeType": "text/html",
            "text": "<!doctype html>\n<html lang=\"ro\">\n  <head>\n    <!-- Build: 2025-10-12-v3 -->\n    <meta charset=\"UTF-8\" />\n    <link rel=\"icon\" type=\"image/svg+xml\" href=\"/vite.svg\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>AMP - Asura Management Platform</title>\n    <style>\n\n      #root:empty::before {\n        content: \"Se încarcă aplicația...\";\n        display: flex;\n        justify-content: center;\n        align-items: center;\n        height: 100vh;\n        font-family: system-ui, sans-serif;\n        font-size: 1.25rem;\n        color: #666;\n      }\n      \n      /* Basic loading spinner */\n      @keyframes spin {\n        0% { transform: rotate(0deg); }\n        100% { transform: rotate(360deg); }\n      }\n      \n      .fallback-loader {\n        border: 4px solid #f3f3f3;\n        border-top: 4px solid #f97316;\n        border-radius: 50%;\n        width: 40px;\n        height: 40px;\n        animation: spin 1s linear infinite;\n        margin: 20px auto;\n        display: none;\n      }\n      \n      #root:empty + .fallback-loader {\n        display: block;\n      }\n    </style>\n    <script type=\"module\" crossorigin src=\"/assets/index-ofA_REET.js\"></script>\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/vendor-DO67cRkI.js\">\n    <link rel=\"modulepreload\" crossorigin href=\"/assets/keycloak-vendor-7ak_DvKe.js\">\n    <link rel=\"stylesheet\" crossorigin href=\"/assets/index-s6Wg9anV.css\">\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <div class=\"fallback-loader\"></div>\n    <script>\n\n      setTimeout(() => {\n        const root = document.getElementById('root');\n        if (!root.childElementCount) {\n          root.innerHTML = `\n            <div class=\"flex flex-col items-center justify-center h-screen\">\n              <h1 class=\"text-xl font-bold mb-4\">Aplicația nu s-a putut încărca</h1>\n              <p class=\"text-red-600 mb-4\">Aplicația nu a putut fi inițializată. Acest lucru ar putea fi din cauza:</p>\n              <ul class=\"list-disc pl-5 mb-4\">\n                <li>Serviciul de autentificare (Keycloak) nu rulează</li>\n                <li>Erori JavaScript în timpul inițializării</li>\n                <li>Probleme de conectivitate la rețea</li>\n              </ul>\n              <button onclick=\"window.location.reload()\" class=\"px-4 py-2 bg-orange-500 text-white rounded hover:bg-orange-600\">\n                Reîncarcă aplicația\n              </button>\n            </div>\n          `;\n        }\n      }, 5000);\n    </script>\n  </body>\n</html>\n"
